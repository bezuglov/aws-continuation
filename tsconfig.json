{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "declaration": true,
        "declarationDir": "./dist/types",
        "emitDeclarationOnly": false,
        "outDir": "./dist/esm",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true
    },
    "include": ["src"]
}
